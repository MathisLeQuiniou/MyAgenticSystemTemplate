# Copy to .env and adapt.  cp .env.example .env

# --- Database (local PostgreSQL) -------------------------------------------
# The database is created (if missing) and migrated by `python -m backend.db.init_db`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_template_db
DB_SCHEMA=app
CHECKPOINT_SCHEMA=langgraph

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
NGINX_PORT=80
LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:5173"]

# --- LLM Internal Service ---------------------------------------------------
# Your Organization internal service OpenAI-compatible API
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_CLIENT_ID=
INTERNAL_LLM_CA_BUNDLE=
INTERNAL_LLM_PROXY=

# --- Graph execution --------------------------------------------------------------
GRAPH_RECURSION_LIMIT=50
RUN_TIMEOUT_SECONDS=300
