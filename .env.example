# Copy to .env and adapt.  cp .env.example .env

# --- Database (local PostgreSQL) -------------------------------------------
# The database is created automatically by `./app.sh setup` if it doesn't exist.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_template
DB_SCHEMA=app
CHECKPOINT_SCHEMA=langgraph

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:5173"]

# --- LLM ------------------------------------------------------------------------
# Profile used when a run doesn't specify one (overrides `default` in models.yaml).
# Use "fake" to run everything offline without any LLM.
# DEFAULT_MODEL_PROFILE=ollama

OPENAI_API_KEY=

# Internal OpenAI-compatible API (profile "internal" in backend/config/models.yaml)
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_CLIENT_ID=
INTERNAL_LLM_CA_BUNDLE=
INTERNAL_LLM_PROXY=

# --- Graph execution --------------------------------------------------------------
GRAPH_RECURSION_LIMIT=50
RUN_TIMEOUT_SECONDS=300
